<UserControl x:Class="Chirpdesk.Onboarding.OnboardingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource CdCanvas}">

    <Grid Margin="44,36,44,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    MaxWidth="720"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <TextBlock Text="CHIRPDESK"
                       FontFamily="{StaticResource CdBodyFont}"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource CdAccent}" />

            <TextBlock Text="Your chats, out of the way."
                       FontFamily="{StaticResource CdDisplayFont}"
                       FontSize="34"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource CdText}"
                       Margin="0,6,0,0" />

            <TextBlock Text="Chirpdesk keeps your messengers warm in the background and turns their notifications into Windows toasts. The window only appears when you ask for it."
                       Style="{StaticResource MutedText}"
                       FontSize="14"
                       TextWrapping="Wrap"
                       Margin="0,10,0,0" />

            <Border Style="{StaticResource Card}" Padding="22" Margin="0,24,0,0">
                <StackPanel>

                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="26" Height="26" CornerRadius="13"
                                Background="{DynamicResource CdAccentSoft}"
                                VerticalAlignment="Top">
                            <TextBlock Text="1"
                                       FontFamily="{StaticResource CdBodyFont}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource CdAccent}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock Text="Pick a chat"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource CdText}" />
                            <TextBlock Text="Open Plugins &amp; services and activate WhatsApp, Telegram or Messenger. Add another account whenever you need a second login."
                                       Style="{StaticResource MutedText}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="26" Height="26" CornerRadius="13"
                                Background="{DynamicResource CdAccentSoft}"
                                VerticalAlignment="Top">
                            <TextBlock Text="2"
                                       FontFamily="{StaticResource CdBodyFont}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource CdAccent}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock Text="Press Ctrl+K"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource CdText}" />
                            <TextBlock Text="The palette lists your open chats and the plugins you can start. Type to search, Enter to open, Esc to go back."
                                       Style="{StaticResource MutedText}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="26" Height="26" CornerRadius="13"
                                Background="{DynamicResource CdAccentSoft}"
                                VerticalAlignment="Top">
                            <TextBlock Text="3"
                                       FontFamily="{StaticResource CdBodyFont}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource CdAccent}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock Text="It lives in the tray"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource CdText}" />
                            <TextBlock Text="Closing the window keeps chats warm and quiet. Quit from the tray icon; nothing shows itself unless you ask."
                                       Style="{StaticResource MutedText}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>

                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                <Button Content="Open plugins"
                        Style="{StaticResource PillButton}"
                        Padding="14,8"
                        Click="OnOpenPlugins" />
                <Button Content="Got it"
                        Style="{StaticResource GhostButton}"
                        Padding="14,7"
                        Margin="10,0,0,0"
                        Click="OnDismiss" />
            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="1"
                   Text="Ctrl+K  palette     Ctrl+Shift+K  tabs     Ctrl+Tab  cycle     Esc  back"
                   Style="{StaticResource MutedText}"
                   FontFamily="{StaticResource CdMonoFont}"
                   FontSize="11"
                   HorizontalAlignment="Center"
                   Margin="0,18,0,0" />
    </Grid>
</UserControl>
