<UserControl x:Class="Chirpdesk.About.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource CdCanvas}"
             TextOptions.TextFormattingMode="Display"
             UseLayoutRounding="True">
    <Grid Margin="36,26,36,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <ContentControl x:Name="PageIcon" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="About"
                               FontFamily="{StaticResource CdDisplayFont}"
                               FontSize="30"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource CdText}" />
                </StackPanel>
            </StackPanel>
            <Button Grid.Column="1" Content="Back" Style="{StaticResource GhostButton}" Click="OnBack" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="980" HorizontalAlignment="Stretch">
                <Border Style="{StaticResource CdPanel}" Padding="28">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Source="pack://application:,,,/Chirpdesk;component/Assets/chirpdesk-512.png"
                               Width="88"
                               Height="88"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1" Margin="22,0,0,0">
                            <TextBlock Text="Chirpdesk"
                                       FontFamily="{StaticResource CdDisplayFont}"
                                       FontSize="34"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource CdText}" />
                            <TextBlock x:Name="VersionText"
                                       FontSize="12"
                                       Foreground="{DynamicResource CdAccent}"
                                       Margin="0,2,0,10" />
                            <TextBlock Text="Your chats, out of the way. A warm tray desk for web messengers, with real Windows notifications."
                                       FontSize="14"
                                       Foreground="{DynamicResource CdTextMuted}"
                                       TextWrapping="Wrap"
                                       MaxWidth="620" />
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Content="GitHub repository"
                                        Style="{StaticResource PillButton}"
                                        Padding="14,8"
                                        Tag="https://github.com/anik-amd/Chirpdesk"
                                        Click="OnOpenLink" />
                                <Button Content="Report an issue"
                                        Style="{StaticResource GhostButton}"
                                        Padding="14,8"
                                        Margin="8,0,0,0"
                                        Tag="https://github.com/anik-amd/Chirpdesk/issues"
                                        Click="OnOpenLink" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="Made by" Style="{StaticResource Heading}" Margin="0,26,0,10" />
                <Border Style="{StaticResource CdPanel}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource CdAccentSoft}">
                            <TextBlock Text="AA"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource CdAccent}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock Text="Anik Ahmed"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource CdText}" />
                            <TextBlock Text="Creator and maintainer"
                                       FontSize="12"
                                       Foreground="{DynamicResource CdTextMuted}" />
                            <Button Content="github.com/anik-amd"
                                    Style="{StaticResource GhostButton}"
                                    HorizontalAlignment="Left"
                                    Padding="0"
                                    Margin="0,4,0,0"
                                    Tag="https://github.com/anik-amd"
                                    Click="OnOpenLink" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="Built with" Style="{StaticResource Heading}" Margin="0,26,0,10" />
                <Border Style="{StaticResource CdPanel}" Padding="0">
                    <StackPanel x:Name="CreditsPanel" Margin="18,8,18,8" />
                </Border>

                <TextBlock Text="Licenses" Style="{StaticResource Heading}" Margin="0,26,0,10" />
                <Border Style="{StaticResource CdPanel}">
                    <StackPanel>
                        <TextBlock Text="Chirpdesk is open source. Each dependency keeps its own license; the links below point at the upstream project and license."
                                   Style="{StaticResource MutedText}"
                                   TextWrapping="Wrap" />
                        <StackPanel x:Name="LicensesPanel" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
