<UserControl x:Class="Chirpdesk.CommandBar.CommandBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MaxHeight="420"
             Focusable="False"
             IsTabStop="False"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">

    <UserControl.Resources>
        <Style x:Key="BarRow" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource CdPaletteSelection}" />
                                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource CdPaletteAccent}" />
                                <Setter TargetName="Row" Property="BorderThickness" Value="2,0,0,0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Opaque surface and no effect: ClearType and crisp 16 px text need an opaque parent. -->
    <Border x:Name="Root"
            CornerRadius="12"
            BorderThickness="1"
            Background="{DynamicResource CdPaletteSurface}"
            BorderBrush="{DynamicResource CdPaletteRule}"
            RenderOptions.ClearTypeHint="Enabled">

        <Grid Margin="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="8,6,8,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ContentControl x:Name="SearchIcon"
                                Width="18"
                                Height="18"
                                Margin="2,0,10,0"
                                VerticalAlignment="Center" />

                <Grid Grid.Column="1">
                    <TextBox x:Name="QueryBox"
                             Visibility="Collapsed"
                             Height="36"
                             Padding="0,6"
                             BorderThickness="0"
                             Background="Transparent"
                             VerticalContentAlignment="Center"
                             FontFamily="Segoe UI Variable Text, Segoe UI"
                             FontSize="16"
                             Foreground="{DynamicResource CdPaletteText}"
                             CaretBrush="{DynamicResource CdPaletteAccent}"
                             SelectionBrush="{DynamicResource CdPaletteSelection}"
                             FocusVisualStyle="{x:Null}"
                             TextChanged="OnQueryChanged" />
                    <TextBlock x:Name="Header"
                               IsHitTestVisible="False"
                               VerticalAlignment="Center"
                               FontFamily="Segoe UI Variable Text, Segoe UI"
                               FontSize="16"
                               Foreground="{DynamicResource CdPaletteMuted}"
                               TextTrimming="CharacterEllipsis"
                               Text="Search tabs, plugins, commands…" />
                </Grid>
            </Grid>

            <ListBox x:Name="Rows"
                     Grid.Row="1"
                     Margin="2,2,2,0"
                     Background="Transparent"
                     BorderThickness="0"
                     Focusable="False"
                     IsTabStop="False"
                     IsHitTestVisible="False"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ItemContainerStyle="{StaticResource BarRow}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ContentControl Grid.Column="0"
                                            Content="{Binding Icon}"
                                            Width="24"
                                            Height="24"
                                            VerticalAlignment="Center" />

                            <TextBlock Grid.Column="1"
                                       Text="{Binding Name}"
                                       FontFamily="Segoe UI Variable Text, Segoe UI"
                                       FontSize="14"
                                       VerticalAlignment="Center"
                                       Margin="12,0,12,0"
                                       TextTrimming="CharacterEllipsis" />

                            <Border x:Name="UnreadBadge"
                                    Grid.Column="2"
                                    Background="{DynamicResource CdPaletteRaised}"
                                    CornerRadius="9"
                                    Padding="7,1"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding UnreadText}"
                                           FontFamily="Cascadia Mono, Consolas"
                                           FontSize="11"
                                           Foreground="{DynamicResource CdPaletteAccent}" />
                            </Border>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding UnreadText}" Value="">
                                <Setter TargetName="UnreadBadge" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="EmptyText"
                       Grid.Row="1"
                       Margin="16,14"
                       FontFamily="Segoe UI Variable Text, Segoe UI"
                       FontSize="14"
                       Foreground="{DynamicResource CdPaletteMuted}"
                       Visibility="Collapsed"
                       Text="No matches." />

            <Border Grid.Row="2"
                    BorderBrush="{DynamicResource CdPaletteRule}"
                    BorderThickness="0,1,0,0"
                    Margin="8,5,8,2">
                <TextBlock x:Name="Hint"
                           Margin="2,6,2,3"
                           FontFamily="Cascadia Mono, Consolas"
                           FontSize="10"
                           Foreground="{DynamicResource CdPaletteMuted}"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap"
                           Text="Enter to run · Esc back" />
            </Border>
        </Grid>
    </Border>
</UserControl>
