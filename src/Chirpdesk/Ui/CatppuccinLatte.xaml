<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Catppuccin Latte. Mauve is the accent here because Latte Blue is 4.34:1 on the
         base, below the 4.5:1 the theme check requires; Mauve is the nearest official
         accent that clears it. Dark flavours use Blue. -->
    <SolidColorBrush x:Key="CdCanvas" Color="#E6E9EF" />
    <SolidColorBrush x:Key="CdSurface" Color="#EFF1F5" />
    <SolidColorBrush x:Key="CdSurfaceAlt" Color="#DCE0E8" />
    <SolidColorBrush x:Key="CdText" Color="#4C4F69" />
    <SolidColorBrush x:Key="CdTextMuted" Color="#5C5F77" />
    <SolidColorBrush x:Key="CdRule" Color="#BCC0CC" />
    <SolidColorBrush x:Key="CdAccent" Color="#8839EF" />
    <SolidColorBrush x:Key="CdAccentSoft" Color="#CCD0DA" />
    <SolidColorBrush x:Key="CdDanger" Color="#D20F39" />
    <SolidColorBrush x:Key="CdOnAccent" Color="#EFF1F5" />

    <SolidColorBrush x:Key="CdPalette" Color="#EFF1F5" />
    <SolidColorBrush x:Key="CdPaletteSurface" Color="#EFF1F5" />
    <SolidColorBrush x:Key="CdPaletteRaised" Color="#EFF1F5" />
    <SolidColorBrush x:Key="CdPaletteText" Color="#4C4F69" />
    <SolidColorBrush x:Key="CdPaletteMuted" Color="#5C5F77" />
    <SolidColorBrush x:Key="CdPaletteRule" Color="#BCC0CC" />
    <SolidColorBrush x:Key="CdPaletteSelection" Color="#CCD0DA" />
    <SolidColorBrush x:Key="CdPaletteAccent" Color="#8839EF" />
    <SolidColorBrush x:Key="CdScrollThumb" Color="#ACB0BE" />
    <SolidColorBrush x:Key="CdControlHover" Color="#CCD0DA" />
    <SolidColorBrush x:Key="CdScrim" Color="#66000000" />
</ResourceDictionary>
