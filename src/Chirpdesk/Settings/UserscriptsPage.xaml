<UserControl x:Class="Chirpdesk.Settings.UserscriptsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource CdCanvas}">
    <Grid Margin="36,26,36,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ContentControl x:Name="PageIcon" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBlock Grid.Column="1" Text="User scripts"
                       FontFamily="{StaticResource CdDisplayFont}" FontSize="26" FontWeight="SemiBold"
                       Foreground="{DynamicResource CdText}" VerticalAlignment="Center" />
            <Button Grid.Column="2" Content="Back" Style="{StaticResource GhostButton}"
                    Padding="16,8" Click="OnBack" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,18,0,0">
            <StackPanel>

                <TextBlock Text="Run by the Userscripts plugin"
                           Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource CdPanel}">
                    <StackPanel>
                        <TextBlock Text="Scripts are third-party code. They run in the page with your signed-in session, so install only what you trust. The plugin owns the files and checks their update URLs; Chirpdesk does not sign them."
                                   Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,12" />
                        <TextBlock x:Name="StatusText" Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,10" />
                        <WrapPanel>
                            <Button Content="Add from URL" Style="{StaticResource GhostButton}" Padding="12,7" Margin="0,0,8,0" Click="OnAdd" />
                            <Button Content="Check now" Style="{StaticResource GhostButton}" Padding="12,7" Margin="0,0,8,0" Click="OnCheck" />
                            <Button Content="Update all" Style="{StaticResource GhostButton}" Padding="12,7" Margin="0,0,8,0" Click="OnUpdateAll" />
                            <Button Content="Open folder" Style="{StaticResource GhostButton}" Padding="12,7" Click="OnOpenFolder" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="Updates" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource CdPanel}">
                    <StackPanel>
                        <CheckBox x:Name="CheckUpdatesBox" Content="Check for updates"
                                  Foreground="{DynamicResource CdText}" Margin="0,0,0,8"
                                  Checked="OnConfigChanged" Unchecked="OnConfigChanged" />
                        <CheckBox x:Name="AutoBox" Content="Install updates automatically"
                                  Foreground="{DynamicResource CdText}"
                                  Checked="OnConfigChanged" Unchecked="OnConfigChanged" />
                        <TextBlock x:Name="ConfigNote" Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <TextBlock Text="Installed scripts" Style="{StaticResource SectionTitle}" />
                <StackPanel x:Name="ScriptsPanel" />
                <TextBlock x:Name="EmptyText" Text="No scripts installed yet." Style="{StaticResource MutedText}" Margin="4,8,0,0" />
            </StackPanel>
        </ScrollViewer>

        <!-- Consent sheet -->
        <Border x:Name="ConsentLayer" Grid.RowSpan="2" Visibility="Collapsed"
                Background="#B0000000">
            <Border Style="{StaticResource CdPanel}" Width="620" MaxHeight="640"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button Content="Cancel" Style="{StaticResource GhostButton}" Padding="14,7"
                                Margin="0,0,8,0" Click="OnConsentCancel" />
                        <Button Content="Install" Style="{StaticResource PillButton}" Padding="16,8"
                                Click="OnConsentInstall" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="ConsentTitle" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{DynamicResource CdText}" Margin="0,0,0,8" />
                            <TextBlock x:Name="ConsentBody" Style="{StaticResource MutedText}"
                                       TextWrapping="Wrap" FontSize="12" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
