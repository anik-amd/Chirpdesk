<UserControl x:Class="Chirpdesk.Settings.PluginsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource CdCanvas}">

    <Grid Margin="28,22,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <ContentControl x:Name="PageIcon" Width="28" Height="28" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="Plugins"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource CdText}" />
                </StackPanel>
            </StackPanel>

            <Button Grid.Column="1" Content="Back" Style="{StaticResource GhostButton}" VerticalAlignment="Top" Click="OnBack" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Installed" Style="{StaticResource Heading}" Margin="0,0,0,12" />
                        <WrapPanel x:Name="PluginsPanel" Orientation="Horizontal" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                    <StackPanel>
                        <TextBlock Text="Browse" Style="{StaticResource Heading}" Margin="0,0,0,12" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Open plugins folder" Style="{StaticResource GhostButton}" Click="OnOpenPluginsFolder" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
