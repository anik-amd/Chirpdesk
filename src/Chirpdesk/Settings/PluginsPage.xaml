<UserControl x:Class="Chirpdesk.Settings.PluginsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource CdCanvas}">

    <Grid Margin="28,22,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Plugins"
                           FontFamily="Segoe UI Variable Display, Segoe UI"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource CdText}" />
                <TextBlock Text="One plugin is one site. Activate it once, then add as many accounts as you need."
                           Style="{StaticResource MutedText}"
                           Margin="0,5,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Button Grid.Column="1" Content="Back" Style="{StaticResource GhostButton}" VerticalAlignment="Top" Click="OnBack" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Installed" Style="{StaticResource Heading}" />
                        <TextBlock Text="Bundled today. User plugins are read from the plugins folder."
                                   Style="{StaticResource MutedText}"
                                   Margin="0,4,0,10" />
                        <WrapPanel x:Name="PluginsPanel" Orientation="Horizontal" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                    <StackPanel>
                        <TextBlock Text="Browse" Style="{StaticResource Heading}" />
                        <TextBlock Text="A signed repository with install, update and signatures arrives in phase 5. Until then plugins are bundled or dropped into the user folder."
                                   Style="{StaticResource MutedText}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,12" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Open plugins folder" Style="{StaticResource GhostButton}" Click="OnOpenPluginsFolder" />
                            <TextBlock Text="Install and update are not implemented yet."
                                       Style="{StaticResource MutedText}"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
