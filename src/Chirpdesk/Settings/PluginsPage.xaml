<UserControl x:Class="Chirpdesk.Settings.PluginsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource CdCanvas}">

    <UserControl.Resources>
        <Style x:Key="CdSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource CdText}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Track"
                                    Width="34"
                                    Height="18"
                                    CornerRadius="9"
                                    Background="{DynamicResource CdRule}"
                                    VerticalAlignment="Center">
                                <Ellipse x:Name="Knob"
                                         Width="14"
                                         Height="14"
                                         Fill="{DynamicResource CdSurface}"
                                         HorizontalAlignment="Left"
                                         Margin="2,0,0,0" />
                            </Border>
                            <ContentPresenter Margin="9,0,0,0"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource CdAccent}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,2,0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PluginTab" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource CdTextMuted}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Segment"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,2"
                                Padding="10,6,10,8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Segment" Property="BorderBrush" Value="{DynamicResource CdAccent}" />
                                <Setter Property="Foreground" Value="{DynamicResource CdText}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource CdText}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootGrid" Margin="28,22,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <ContentControl x:Name="PageIcon" Width="28" Height="28" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="Plugins"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource CdText}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="Back"
                        Style="{StaticResource GhostButton}"
                        Padding="14,8"
                        Click="OnBack" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="InstalledTabButton"
                             Content="Installed"
                             GroupName="PluginsTabs"
                             IsChecked="True"
                             Style="{StaticResource PluginTab}"
                             Checked="OnShowInstalled" />
                <RadioButton x:Name="BrowseTabButton"
                             Content="Browse"
                             GroupName="PluginsTabs"
                             Style="{StaticResource PluginTab}"
                             Checked="OnShowBrowse" />
            </StackPanel>
            <TextBlock x:Name="RepositoryStatus"
                       Style="{StaticResource MutedText}"
                       Text=""
                       TextWrapping="Wrap"
                       Margin="0,6,0,0" />
        </StackPanel>

        <ScrollViewer x:Name="InstalledTab" Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Installed plugins" Style="{StaticResource Heading}" Margin="0,0,0,6" />
                        <TextBlock x:Name="InstalledSummary"
                                   Style="{StaticResource MutedText}"
                                   Text="Services, themes and filters on this machine."
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,14" />
                        <WrapPanel x:Name="PluginsPanel" Orientation="Horizontal" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                    <StackPanel>
                        <TextBlock Text="Plugin folder" Style="{StaticResource Heading}" Margin="0,0,0,10" />
                        <TextBlock Text="User-installed plugins live here. Repository installs write to the same folder and keep a source record for updates."
                                   FontSize="12"
                                   Foreground="{DynamicResource CdTextMuted}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Open plugins folder" Style="{StaticResource GhostButton}" Click="OnOpenPluginsFolder" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="BrowseTab" Grid.Row="2" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Repositories"
                                       Style="{StaticResource Heading}"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Add repository"
                                        Style="{StaticResource PillButton}"
                                        Padding="14,8"
                                        Click="OnOpenAddRepository" />
                                <Button Content="Manage repositories"
                                        Style="{StaticResource GhostButton}"
                                        Padding="14,8"
                                        Margin="8,0,0,0"
                                        Click="OnOpenManageRepositories" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="A repository is a static HTTPS folder with a signed index. Chirpdesk verifies the index and every archive before installing."
                                   FontSize="12"
                                   Foreground="{DynamicResource CdTextMuted}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                    <StackPanel>
                        <TextBlock Text="Browse plugins" Style="{StaticResource Heading}" Margin="0,0,0,6" />
                        <TextBlock Text="Select a plugin to see its source, version, permissions and hash before installing."
                                   FontSize="12"
                                   Foreground="{DynamicResource CdTextMuted}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10" />
                        <StackPanel x:Name="AvailablePluginsPanel" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>


        <!-- Modal overlay: stays inside the plugins page, so the title bar and window never change. -->
        <Grid x:Name="ModalLayer"
              Grid.RowSpan="3"
              Panel.ZIndex="50"
              Background="#99000000"
              Visibility="Collapsed">
            <Border Width="560"
                    MaxHeight="620"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource CdPalette}"
                    BorderBrush="{DynamicResource CdRule}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="ModalTitle"
                               Text="Add plugins repository"
                               FontFamily="{StaticResource CdDisplayFont}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource CdText}" />

                    <TextBlock x:Name="ModalDescription"
                               Grid.Row="1"
                               Text="Point at a static HTTPS folder containing index.json, index.json.sig and key.pem. The key is pinned on first sync."
                               FontSize="12"
                               Foreground="{DynamicResource CdTextMuted}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,16" />

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <StackPanel x:Name="AddRepositoryForm">
                                <TextBlock Text="Repository URL"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource CdText}"
                                           Margin="0,0,0,6" />
                                <TextBox x:Name="ModalRepositoryUrl"
                                         Height="36"
                                         Padding="9,5"
                                         VerticalContentAlignment="Center"
                                         Background="{DynamicResource CdSurfaceAlt}"
                                         Foreground="{DynamicResource CdText}"
                                         BorderBrush="{DynamicResource CdRule}"
                                         AutomationProperties.Name="Repository URL" />
                                <TextBlock Text="Examples: a GitHub Pages folder, an S3 static site, or any HTTPS host. No query string or credentials."
                                           FontSize="11"
                                           Foreground="{DynamicResource CdTextMuted}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0" />
                            </StackPanel>

                            <StackPanel x:Name="ManageRepositoryList" Visibility="Collapsed">
                                <StackPanel x:Name="ManageRepositoriesPanel" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button x:Name="ModalSecondaryButton"
                                Content="Cancel"
                                Style="{StaticResource GhostButton}"
                                Padding="14,7"
                                Click="OnCloseModal" />
                        <Button x:Name="ModalPrimaryButton"
                                Content="Add repository"
                                Style="{StaticResource PillButton}"
                                Padding="14,8"
                                Margin="8,0,0,0"
                                Click="OnSaveRepository" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Name prompt for a new account: each instance keeps its own session and needs a
             distinguishable name in the sidebar and command bar. -->
        <Grid x:Name="AccountNameLayer"
              Grid.RowSpan="3"
              Panel.ZIndex="80"
              Background="#99000000"
              Visibility="Collapsed">
            <Border Width="440"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource CdPalette}"
                    BorderBrush="{DynamicResource CdRule}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="24">
                <StackPanel>
                    <TextBlock x:Name="AccountNameTitle"
                               Text="Name this account"
                               FontFamily="{StaticResource CdDisplayFont}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource CdText}" />
                    <TextBlock x:Name="AccountNameDescription"
                               Text="The name appears in the sidebar and the command bar."
                               FontSize="12"
                               Foreground="{DynamicResource CdTextMuted}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,12" />
                    <TextBox x:Name="AccountNameBox"
                             Height="34"
                             Padding="9,5"
                             VerticalContentAlignment="Center"
                             Background="{DynamicResource CdSurfaceAlt}"
                             Foreground="{DynamicResource CdText}"
                             BorderBrush="{DynamicResource CdRule}"
                             KeyDown="OnAccountNameKeyDown"
                             AutomationProperties.Name="Account name" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Content="Cancel"
                                Style="{StaticResource GhostButton}"
                                Padding="14,7"
                                Click="OnCancelAccountName" />
                        <Button x:Name="AccountNameConfirm"
                                Content="Add account"
                                Style="{StaticResource PillButton}"
                                Padding="14,8"
                                Margin="8,0,0,0"
                                Click="OnConfirmAccountName" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Per-plugin settings: service accounts, boot/mute state, and the cleaner's storage tools. -->
        <Grid x:Name="PluginSettingsLayer"
              Grid.RowSpan="3"
              Panel.ZIndex="70"
              Background="#99000000"
              Visibility="Collapsed">
            <Border Width="640"
                    MaxHeight="680"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource CdPalette}"
                    BorderBrush="{DynamicResource CdRule}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="PluginSettingsTitle"
                               Text="Plugin settings"
                               FontFamily="{StaticResource CdDisplayFont}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource CdText}" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                        <StackPanel x:Name="PluginSettingsBody" />
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button Content="Close"
                                Style="{StaticResource GhostButton}"
                                Padding="14,7"
                                Click="OnClosePluginSettings" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Consent is separate from repository management: it is the last gate before code-adjacent
             content from a third-party repo is written to the user plugin root. -->
        <Grid x:Name="ConsentLayer"
              Grid.RowSpan="3"
              Panel.ZIndex="60"
              Background="#99000000"
              Visibility="Collapsed">
            <Border Width="520"
                    MaxHeight="560"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource CdPalette}"
                    BorderBrush="{DynamicResource CdRule}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="ConsentTitle"
                               Text="Install plugin?"
                               FontFamily="{StaticResource CdDisplayFont}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource CdText}" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                        <StackPanel x:Name="ConsentBody" />
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button x:Name="ConsentSecondaryButton"
                                Content="Cancel"
                                Style="{StaticResource GhostButton}"
                                Padding="14,7"
                                Click="OnCancelConsent" />
                        <Button x:Name="ConsentPrimaryButton"
                                Content="Install"
                                Style="{StaticResource PillButton}"
                                Padding="14,8"
                                Margin="8,0,0,0"
                                Click="OnConfirmConsent" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
