<UserControl x:Class="Chirpdesk.Settings.PluginsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource CdCanvas}">

    <Grid x:Name="RootGrid" Margin="28,22,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <ContentControl x:Name="PageIcon" Width="28" Height="28" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="Plugins"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource CdText}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="Add Plugins Repo"
                        Style="{StaticResource PillButton}"
                        Padding="14,8"
                        Click="OnOpenAddRepository" />
                <Button Content="Manage plugin repos"
                        Style="{StaticResource GhostButton}"
                        Padding="14,8"
                        Margin="8,0,0,0"
                        Click="OnOpenManageRepositories" />
                <Button Content="Back"
                        Style="{StaticResource GhostButton}"
                        Padding="14,8"
                        Margin="8,0,0,0"
                        Click="OnBack" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Installed" Style="{StaticResource Heading}" Margin="0,0,0,12" />
                        <WrapPanel x:Name="PluginsPanel" Orientation="Horizontal" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                    <StackPanel>
                        <TextBlock Text="Available from repositories" Style="{StaticResource Heading}" Margin="0,0,0,8" />
                        <TextBlock Text="Sync a repository from Manage plugin repos to see its compatible plugins here."
                                   FontSize="12"
                                   Foreground="{DynamicResource CdTextMuted}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10" />
                        <TextBlock x:Name="RepositoryStatus"
                                   Style="{StaticResource MutedText}"
                                   Text="No repositories configured."
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8" />
                        <StackPanel x:Name="AvailablePluginsPanel" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                    <StackPanel>
                        <TextBlock Text="Browse" Style="{StaticResource Heading}" Margin="0,0,0,12" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Open plugins folder" Style="{StaticResource GhostButton}" Click="OnOpenPluginsFolder" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Modal overlay: stays inside the plugins page, so the title bar and window never change. -->
        <Grid x:Name="ModalLayer"
              Grid.RowSpan="2"
              Panel.ZIndex="50"
              Background="#99000000"
              Visibility="Collapsed">
            <Border Width="560"
                    MaxHeight="620"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource CdPalette}"
                    BorderBrush="{DynamicResource CdRule}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="ModalTitle"
                               Text="Add plugins repository"
                               FontFamily="{StaticResource CdDisplayFont}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource CdText}" />

                    <TextBlock x:Name="ModalDescription"
                               Grid.Row="1"
                               Text="Point at a static HTTPS folder containing index.json, index.json.sig and key.pem. The key is pinned on first sync."
                               FontSize="12"
                               Foreground="{DynamicResource CdTextMuted}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,16" />

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <StackPanel x:Name="AddRepositoryForm">
                                <TextBlock Text="Repository URL"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource CdText}"
                                           Margin="0,0,0,6" />
                                <TextBox x:Name="ModalRepositoryUrl"
                                         Height="36"
                                         Padding="9,5"
                                         VerticalContentAlignment="Center"
                                         Background="{DynamicResource CdSurfaceAlt}"
                                         Foreground="{DynamicResource CdText}"
                                         BorderBrush="{DynamicResource CdRule}"
                                         AutomationProperties.Name="Repository URL" />
                                <TextBlock Text="Examples: a GitHub Pages folder, an S3 static site, or any HTTPS host. No query string or credentials."
                                           FontSize="11"
                                           Foreground="{DynamicResource CdTextMuted}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0" />
                            </StackPanel>

                            <StackPanel x:Name="ManageRepositoryList" Visibility="Collapsed">
                                <StackPanel x:Name="ManageRepositoriesPanel" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button x:Name="ModalSecondaryButton"
                                Content="Cancel"
                                Style="{StaticResource GhostButton}"
                                Padding="14,7"
                                Click="OnCloseModal" />
                        <Button x:Name="ModalPrimaryButton"
                                Content="Add repository"
                                Style="{StaticResource PillButton}"
                                Padding="14,8"
                                Margin="8,0,0,0"
                                Click="OnSaveRepository" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Consent is separate from repository management: it is the last gate before code-adjacent
             content from a third-party repo is written to the user plugin root. -->
        <Grid x:Name="ConsentLayer"
              Grid.RowSpan="2"
              Panel.ZIndex="60"
              Background="#99000000"
              Visibility="Collapsed">
            <Border Width="520"
                    MaxHeight="560"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource CdPalette}"
                    BorderBrush="{DynamicResource CdRule}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="ConsentTitle"
                               Text="Install plugin?"
                               FontFamily="{StaticResource CdDisplayFont}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource CdText}" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                        <StackPanel x:Name="ConsentBody" />
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button Content="Cancel"
                                Style="{StaticResource GhostButton}"
                                Padding="14,7"
                                Click="OnCancelConsent" />
                        <Button Content="Install"
                                Style="{StaticResource PillButton}"
                                Padding="14,8"
                                Margin="8,0,0,0"
                                Click="OnConfirmConsent" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
