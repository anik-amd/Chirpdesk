<UserControl x:Class="Chirpdesk.Settings.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource CdCanvas}"
             TextOptions.TextFormattingMode="Display"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <Style x:Key="ChoiceCard" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource CdText}" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Card"
                                Background="{DynamicResource CdSurfaceAlt}"
                                BorderBrush="{DynamicResource CdRule}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="9">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource CdAccent}" />
                                <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                                <Setter TargetName="Card" Property="Padding" Value="8" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource CdControlHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SegmentChoice" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource CdText}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Segment"
                                Background="{DynamicResource CdSurfaceAlt}"
                                BorderBrush="{DynamicResource CdRule}"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="13,7">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Segment" Property="Background" Value="{DynamicResource CdAccent}" />
                                <Setter TargetName="Segment" Property="BorderBrush" Value="{DynamicResource CdAccent}" />
                                <Setter Property="Foreground" Value="{DynamicResource CdOnAccent}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Segment" Property="Background" Value="{DynamicResource CdControlHover}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Segment" Property="Background" Value="{DynamicResource CdAccent}" />
                                <Setter TargetName="Segment" Property="BorderBrush" Value="{DynamicResource CdAccent}" />
                                <Setter Property="Foreground" Value="{DynamicResource CdOnAccent}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CdSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource CdText}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Track"
                                    Width="34"
                                    Height="18"
                                    CornerRadius="9"
                                    Background="{DynamicResource CdRule}"
                                    VerticalAlignment="Center">
                                <Ellipse x:Name="Knob"
                                         Width="14"
                                         Height="14"
                                         Fill="{DynamicResource CdSurface}"
                                         HorizontalAlignment="Left"
                                         Margin="2,0,0,0" />
                            </Border>
                            <ContentPresenter Margin="9,0,0,0"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource CdAccent}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,2,0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource Heading}">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource CdBodyFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource CdText}" />
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Root" Margin="36,26,36,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <ContentControl x:Name="PageIcon" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="Settings"
                               FontFamily="{StaticResource CdDisplayFont}"
                               FontSize="30"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource CdText}" />
                </StackPanel>
            </StackPanel>

            <Button Grid.Column="1"
                    Content="Back"
                    Style="{StaticResource GhostButton}"
                    VerticalAlignment="Top"
                    Click="OnBack" />
        </Grid>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalContentAlignment="Center">
            <StackPanel MaxWidth="980" HorizontalAlignment="Stretch">

                <TextBlock Text="Appearance" Style="{StaticResource SectionTitle}" />

                <Border Style="{StaticResource CdPanel}">
                    <StackPanel>
                        <TextBlock Text="Mode" Style="{StaticResource FieldLabel}" />
                        <WrapPanel Margin="0,8,0,0">
                            <RadioButton x:Name="ThemeSystem"
                                         AutomationProperties.Name="System theme"
                                         GroupName="Theme"
                                         Tag="system"
                                         Content="System"
                                         Style="{StaticResource SegmentChoice}"
                                         Checked="OnThemeChoice" />
                            <RadioButton x:Name="ThemeLight"
                                         AutomationProperties.Name="Light theme"
                                         GroupName="Theme"
                                         Tag="light"
                                         Content="Light"
                                         Style="{StaticResource SegmentChoice}"
                                         Checked="OnThemeChoice" />
                            <RadioButton x:Name="ThemeDark"
                                         AutomationProperties.Name="Dark theme"
                                         GroupName="Theme"
                                         Tag="dark"
                                         Content="Dark"
                                         Style="{StaticResource SegmentChoice}"
                                         Checked="OnThemeChoice" />
                        </WrapPanel>

                        <TextBlock Text="Light palette" Style="{StaticResource FieldLabel}" Margin="0,14,0,8" />
                        <WrapPanel x:Name="LightSchemesPanel" />

                        <TextBlock Text="Dark palette" Style="{StaticResource FieldLabel}" Margin="0,6,0,8" />
                        <WrapPanel x:Name="DarkSchemesPanel" />
                    </StackPanel>
                </Border>

                <Border Height="1" Background="{DynamicResource CdRule}" Margin="0,26,0,22" />

                <TextBlock Text="Sidebar" Style="{StaticResource SectionTitle}" />

                <Border Style="{StaticResource CdPanel}">
                    <StackPanel>
                        <WrapPanel>
                            <RadioButton x:Name="RailAlways"
                                         GroupName="Rail"
                                         Tag="always"
                                         Content="Always show"
                                         Style="{StaticResource SegmentChoice}"
                                         AutomationProperties.Name="Sidebar always show"
                                         Checked="OnRailChoice" />
                            <RadioButton x:Name="RailHover"
                                         GroupName="Rail"
                                         Tag="hover"
                                         Content="Show on hover at left edge"
                                         Style="{StaticResource SegmentChoice}"
                                         AutomationProperties.Name="Show sidebar on hover at left edge"
                                         Checked="OnRailChoice" />
                            <RadioButton x:Name="RailHidden"
                                         GroupName="Rail"
                                         Tag="hidden"
                                         Content="Hide completely"
                                         Style="{StaticResource SegmentChoice}"
                                         AutomationProperties.Name="Sidebar hidden"
                                         Checked="OnRailChoice" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Height="1" Background="{DynamicResource CdRule}" Margin="0,26,0,22" />

                <TextBlock Text="Startup and window" Style="{StaticResource SectionTitle}" />

                <Border Style="{StaticResource CdPanel}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Start at login" Style="{StaticResource FieldLabel}" />
                                    </StackPanel>
                            <CheckBox x:Name="AutostartBox"
                                      AutomationProperties.Name="Start at login"
                                      Grid.Column="1"
                                      Style="{StaticResource CdSwitch}"
                                      VerticalAlignment="Center"
                                      Checked="OnAutostartChanged"
                                      Unchecked="OnAutostartChanged" />
                        </Grid>

                        <Border Height="1" Background="{DynamicResource CdRule}" Margin="0,16,0,16" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Minimize to tray" Style="{StaticResource FieldLabel}" />
                            </StackPanel>
                            <CheckBox x:Name="MinimizeToTrayBox"
                                      AutomationProperties.Name="Minimize to tray"
                                      Grid.Column="1"
                                      Style="{StaticResource CdSwitch}"
                                      VerticalAlignment="Center"
                                      Checked="OnWindowBehaviourChanged"
                                      Unchecked="OnWindowBehaviourChanged" />
                        </Grid>

                        <Border Height="1" Background="{DynamicResource CdRule}" Margin="0,16,0,16" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Close to tray" Style="{StaticResource FieldLabel}" />
                            </StackPanel>
                            <CheckBox x:Name="CloseToTrayBox"
                                      AutomationProperties.Name="Close to tray"
                                      Grid.Column="1"
                                      Style="{StaticResource CdSwitch}"
                                      VerticalAlignment="Center"
                                      Checked="OnWindowBehaviourChanged"
                                      Unchecked="OnWindowBehaviourChanged" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Height="1" Background="{DynamicResource CdRule}" Margin="0,26,0,22" />

                <TextBlock Text="Messaging" Style="{StaticResource SectionTitle}" />

                <Border Style="{StaticResource CdPanel}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Enter sends messages" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="Clicks the site's send button when you press Enter without Shift. Shift+Enter stays a new line, and a page without a send button keeps its own behavior."
                                           Style="{StaticResource MutedText}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                            <CheckBox x:Name="EnterToSendBox"
                                      AutomationProperties.Name="Enter sends messages"
                                      Grid.Column="1"
                                      Style="{StaticResource CdSwitch}"
                                      VerticalAlignment="Center"
                                      Checked="OnEnterToSendChanged"
                                      Unchecked="OnEnterToSendChanged" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="Updates" Style="{StaticResource SectionTitle}" />

                <Border Style="{StaticResource CdPanel}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Check for updates automatically" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="Stable channel only. Downloads are checked against the pinned signing key before anything runs."
                                           Style="{StaticResource MutedText}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,3,18,0" />
                            </StackPanel>
                            <CheckBox x:Name="UpdateAutoBox"
                                      AutomationProperties.Name="Check for updates automatically"
                                      Grid.Column="1"
                                      Style="{StaticResource CdSwitch}"
                                      VerticalAlignment="Center"
                                      Checked="OnUpdateAutoChanged"
                                      Unchecked="OnUpdateAutoChanged" />
                        </Grid>

                        <Border Height="1" Background="{DynamicResource CdRule}" Margin="0,16,0,14" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="UpdateStatus"
                                           Style="{StaticResource MutedText}"
                                           Text="Not checked yet."
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="UpdateVersion"
                                           FontSize="12"
                                           Foreground="{DynamicResource CdAccent}"
                                           Margin="0,4,0,0"
                                           Visibility="Collapsed" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                                <Button x:Name="CheckUpdatesButton"
                                        Content="Check now"
                                        Style="{StaticResource GhostButton}"
                                        Padding="14,7"
                                        Click="OnCheckUpdates" />
                                <Button x:Name="InstallUpdateButton"
                                        Content="Install and restart"
                                        Style="{StaticResource PillButton}"
                                        Padding="14,8"
                                        Margin="8,0,0,0"
                                        Visibility="Collapsed"
                                        Click="OnInstallUpdate" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Height="1" Background="{DynamicResource CdRule}" Margin="0,26,0,22" />

                <TextBlock Text="Do Not Disturb" Style="{StaticResource SectionTitle}" />

                <Border Style="{StaticResource CdPanel}">
                    <StackPanel>
                        <WrapPanel>
                            <RadioButton x:Name="DndOff"
                                         AutomationProperties.Name="Do Not Disturb off"
                                         GroupName="Dnd"
                                         Tag="0"
                                         Content="Off"
                                         Style="{StaticResource SegmentChoice}"
                                         Checked="OnDndChoice" />
                            <RadioButton x:Name="Dnd30"
                                         AutomationProperties.Name="Do Not Disturb 30 minutes"
                                         GroupName="Dnd"
                                         Tag="1"
                                         Content="30 minutes"
                                         Style="{StaticResource SegmentChoice}"
                                         Checked="OnDndChoice" />
                            <RadioButton x:Name="Dnd60"
                                         AutomationProperties.Name="Do Not Disturb 1 hour"
                                         GroupName="Dnd"
                                         Tag="2"
                                         Content="1 hour"
                                         Style="{StaticResource SegmentChoice}"
                                         Checked="OnDndChoice" />
                            <RadioButton x:Name="DndTomorrow"
                                         AutomationProperties.Name="Do Not Disturb until 08:00"
                                         GroupName="Dnd"
                                         Tag="3"
                                         Content="Until 08:00"
                                         Style="{StaticResource SegmentChoice}"
                                         Checked="OnDndChoice" />
                        </WrapPanel>
                        <TextBlock x:Name="DndStatus"
                                   Style="{StaticResource MutedText}"
                                   FontSize="12"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
