<UserControl x:Class="Chirpdesk.Settings.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource CdCanvas}">


    <Grid x:Name="Root" Margin="28,22,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <ContentControl x:Name="PageIcon" Width="28" Height="28" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="Desk settings"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource CdText}" />
                </StackPanel>
                <TextBlock Text="Services, what warms at login, and the space they keep."
                           Style="{StaticResource MutedText}"
                           Margin="0,5,0,0" />
            </StackPanel>

            <Button Grid.Column="1"
                    Content="Back"
                    Style="{StaticResource GhostButton}"
                    VerticalAlignment="Top"
                    Click="OnBack" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Services" Style="{StaticResource Heading}" />
                            <TextBlock Text="Per-account settings. Accounts come from an active plugin."
                                       Style="{StaticResource MutedText}"
                                       Margin="0,4,0,12" />
                            <StackPanel x:Name="ServicesPanel" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Application" Style="{StaticResource Heading}" Margin="0,0,0,12" />

                            <TextBlock Text="Theme" Style="{StaticResource MutedText}" />
                            <ComboBox x:Name="ThemeBox" Margin="0,4,0,14" SelectionChanged="OnThemeChanged" />

                            <CheckBox x:Name="AutostartBox"
                                      Content="Start at login, warm up after 20 s"
                                      Foreground="{DynamicResource CdText}"
                                      FontSize="12"
                                      Margin="0,0,0,14"
                                      Checked="OnAutostartChanged"
                                      Unchecked="OnAutostartChanged" />

                            <TextBlock Text="Do Not Disturb" Style="{StaticResource MutedText}" />
                            <ComboBox x:Name="DndBox" Margin="0,4,0,0" SelectionChanged="OnDndChanged" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Storage" Style="{StaticResource Heading}" />
                            <TextBlock x:Name="ReclaimedText"
                                       Grid.Column="1"
                                       Style="{StaticResource MutedText}"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock x:Name="StorageHint"
                                   Style="{StaticResource MutedText}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,10"
                                   Text="Data is the session and is never trimmed. Cache is the only reclaimable part; warm profiles are trimmed after they sleep." />

                        <StackPanel x:Name="PanelHost" Margin="0,0,0,10" />
                        <StackPanel x:Name="StoragePanel" />

                        <Border Height="1" Background="{DynamicResource CdRule}" Margin="0,12,0,10" />
                        <TextBlock x:Name="OrphanStatus"
                                   Style="{StaticResource MutedText}"
                                   Text="Not scanned yet."
                                   Margin="0,0,0,6" />
                        <StackPanel x:Name="OrphanPanel" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
