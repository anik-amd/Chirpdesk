<Window x:Class="Chirpdesk.Hosting.HostWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Chirpdesk"
        Icon="pack://application:,,,/Chirpdesk;component/Assets/chirpdesk.ico"
        WindowStyle="None"
        WindowStartupLocation="Manual"
        ShowInTaskbar="True"
        ShowActivated="False"
        ResizeMode="CanResize"
        Width="2"
        Height="2"
        Left="-32000"
        Top="-32000"
        Background="#241C22"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        RenderOptions.ClearTypeHint="Enabled">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource CdPaletteText}" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource CdControlHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RailButton" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource CdPaletteSelection}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom chrome: native chrome cannot be themed (PLAN §12). -->
        <Grid x:Name="TitleBar"
              Grid.Row="0"
              Background="{DynamicResource CdPaletteRaised}"
              MouseLeftButtonDown="OnTitleBarMouseDown">
            <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                <Image Width="16"
                       Height="16"
                       Source="pack://application:,,,/Chirpdesk;component/Assets/chirpdesk.ico"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       VerticalAlignment="Center" />
                <TextBlock x:Name="TitleText"
                           Text="Chirpdesk"
                           Margin="9,0,0,0"
                           VerticalAlignment="Center"
                           FontFamily="Segoe UI Variable Display, Segoe UI"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource CdPaletteText}" />
                <TextBlock x:Name="ServiceTitle"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="12"
                           Foreground="{DynamicResource CdPaletteMuted}"
                           Visibility="Collapsed" />
            </StackPanel>

            <Grid x:Name="BusyTrack"
                  Height="2"
                  VerticalAlignment="Bottom"
                  Background="{DynamicResource CdPaletteRule}"
                  ClipToBounds="True"
                  IsHitTestVisible="False"
                  Visibility="Collapsed">
                <Rectangle x:Name="BusyBar"
                           Width="96"
                           HorizontalAlignment="Left"
                           Fill="{DynamicResource CdPaletteAccent}"
                           Opacity="0.9">
                    <Rectangle.RenderTransform>
                        <TranslateTransform x:Name="BusyShift" />
                    </Rectangle.RenderTransform>
                </Rectangle>
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="MinimizeButton"
                        Content="&#xE921;"
                        Style="{StaticResource CaptionButton}"
                        ToolTip="Minimize"
                        Click="OnMinimizeClick" />
                <Button x:Name="MaximizeButton"
                        Content="&#xE922;"
                        Style="{StaticResource CaptionButton}"
                        ToolTip="Maximize"
                        Click="OnMaximizeClick" />
                <Button x:Name="CloseButton"
                        Content="&#xE8BB;"
                        Style="{StaticResource CaptionButton}"
                        ToolTip="Hide to tray"
                        Click="OnCloseClick" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="RailColumn" Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Service rail. Docked when visible; hover mode animates its width from 0 and
                 polls the real cursor so the WebView2 HWND cannot swallow the edge trigger. -->
            <Border x:Name="RailPanel"
                    Grid.Column="0"
                    Width="0"
                    Visibility="Collapsed"
                    ClipToBounds="True"
                    Background="{DynamicResource CdPaletteRaised}"
                    BorderBrush="{DynamicResource CdPaletteRule}"
                    BorderThickness="0,0,1,0">
                <Grid Width="62">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0"
                                  VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="RailServices" Margin="0,10,0,8" />
                    </ScrollViewer>

                    <StackPanel Grid.Row="1" x:Name="RailActions" Margin="0,8,0,12" />
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <!-- The active service webview. Empty while everything is parked. -->
                <Grid x:Name="ServiceLayer" />

                <!-- Settings/Plugins pages replace the page area; the webview is collapsed while
                     a page is open because it is an HWND. -->
                <Grid x:Name="PageLayer" Background="{DynamicResource CdCanvas}" Visibility="Collapsed">
                    <ContentControl x:Name="PageHost" />
                </Grid>
            </Grid>

            <!-- Command Bar overlay. The webview HWND is collapsed first, so the last captured
                 frame sits here as the backdrop and the bar still reads as an overlay. -->
            <Grid x:Name="BarLayer" Grid.ColumnSpan="2" Panel.ZIndex="10" Visibility="Collapsed">
                <Image x:Name="BarBackdrop" Stretch="Fill" />
                <Grid Background="{DynamicResource CdScrim}">
                    <ContentControl x:Name="BarHost"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Top"
                                    MaxWidth="560"
                                    MaxHeight="420"
                                    Margin="24,0" />
                </Grid>
            </Grid>

            <!-- Non-visual framework elements (the tray icon) need a parent to get Loaded. -->
            <Grid x:Name="ContentRoot" Grid.ColumnSpan="2" IsHitTestVisible="False" />
        </Grid>
    </Grid>
</Window>
