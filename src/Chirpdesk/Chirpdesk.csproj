<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Chirpdesk.Core\Chirpdesk.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bundled plugins travel beside the exe; the plugin loader scans this folder at boot. -->
    <None Include="..\..\plugins\**\*"
          Link="plugins\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\chirpdesk.ico" />
    <Resource Include="Assets\chirpdesk-512.png" />
    <Resource Include="Assets\chirpdesk-author.png" />
    <Resource Include="Assets\chirpdesk-tray.ico" />
    <Resource Include="Assets\chirpdesk-tray-unread.ico" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>Assets\chirpdesk.ico</ApplicationIcon>
    <Version>0.3.6</Version>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
  </PropertyGroup>

</Project>
