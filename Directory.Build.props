<Project>

  <PropertyGroup>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <NeutralLanguage>en</NeutralLanguage>
    <Company>Chirpdesk</Company>
    <Product>Chirpdesk</Product>
    <Authors>anik-amd</Authors>
    <Copyright>MIT (c) 2026 anik-amd</Copyright>
    <RepositoryType>git</RepositoryType>
    <VersionPrefix>0.1.0</VersionPrefix>
    <IncludeSourceRevisionInInformationalVersion>true</IncludeSourceRevisionInInformationalVersion>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <!-- One output tree instead of a bin/obj pair per project: the dev disk is small.
       Keeps every build artifact under artifacts/ (already gitignored) and makes
       "delete artifacts/" a complete clean. -->
  <PropertyGroup>
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Core is pure by structure: no UseWPF/UseWindowsForms, no WebView2 package, no P/Invoke.
       Keep it that way; see AGENTS.md invariant 1 and docs/engineering.md. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Chirpdesk.Core'">
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

</Project>
